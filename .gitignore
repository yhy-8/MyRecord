__pycache__/
*.py[cod]
.idea/
# Local user data and derived analysis state (client 的同级目录：项目根)。
Records/
AnalysisReports/
Log/

# 服务端运行时数据空间（权威 state.json、Records、Trash、报告、日志、TLS 私钥）。
server/data/

# 设备身份凭证（服务端签发的 device_id/token），等同密钥，不入版本库。
client/credentials.json

# 运行时配置：config.example.yaml 是提交的模板，此处是用户实际配置，不入版本库。
# 服务端 config.yaml 含模型 API Key,客户端 config.yaml 含服务器地址/校验收信路径;
# 均由用户复制示例后填写,不要提交/分享。
server/config.yaml
client/config.yaml

# Coverage measurement artifacts.
.coverage
.coverage.*
htmlcov/
