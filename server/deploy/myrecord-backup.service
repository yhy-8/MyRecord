# MyRecord 服务端定期备份 systemd 单元（oneshot，由 myrecord-backup.timer 每周触发）。
# 安装（在独立 server 工程内）：
#   sudo cp server/deploy/myrecord-backup.service server/deploy/myrecord-backup.timer /etc/systemd/system/
#   修改 ExecStart 的 backup.sh 路径与 WorkingDirectory 为独立 server 工程绝对路径
#   sudo systemctl daemon-reload && sudo systemctl enable --now myrecord-backup.timer

[Unit]
Description=MyRecord server data backup (weekly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 按实际工程路径修改；backup.sh 从其自身位置推断工程根，读取 config.yaml 的 data_dir。
# 下面路径仅为示例（与 myrecord-server.service 的 WorkingDirectory 一致），请改成你的
# 独立 server 工程绝对路径。
ExecStart=/bin/bash /srv/myrecord/server/deploy/backup.sh
WorkingDirectory=/srv/myrecord
User=root
