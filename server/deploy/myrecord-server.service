# MyRecord 服务端中枢 systemd 单元（裸机 root 运行，明文存储）。
#
# 推荐一键部署（在独立 server 工程内）：
#   sudo python -m server.main deploy
# 该命令会自动带出当前解释器与工程根、按需生成自签证书，写入本单元并执行
# systemctl daemon-reload && systemctl start myrecord-server（只部署并启动，
# 不启用开机自启动）。
# 若同名服务已部署（升级/重装），deploy 会先 systemctl stop 关停旧服务，覆盖本单元后
# 再 daemon-reload && start，仍不 enable 开机自启。
#
# 以下是 deploy 自动生成的等价内容（供手动/审阅参照）。实际部署以 deploy 渲染的单元为准：
# 其 ExecStart 解释器为 server/.venv/bin/python（依赖装进该 venv，不写死 /usr/bin/python3）。
# 下方 ExecStart 的“<...>”为**占位符**，勿直接照抄；请以 `python -m server.main deploy` 生成结果为准。
[Unit]
Description=MyRecord server hub (sync + AI reports + fanout)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=<部署时自动填充：server/.venv/bin/python> -m server.main run
WorkingDirectory=/srv/myrecord
Restart=on-failure
RestartSec=3
User=root
